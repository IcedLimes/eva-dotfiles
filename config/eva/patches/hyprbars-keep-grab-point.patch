+// EVA: dismissing a right-click menu by clicking back on the app (e.g. the
+// page in Firefox) leaves GTK apps ignoring the keyboard, and clicking again
+// doesn't help: Hyprland's state is right and it already counts the window as
+// focused. The app needs to see focus leave and come back, which is what
+// Alt+Tab did. So on the click right after a right-click in the same window,
+// refresh that window's focus. Other clicks are left alone.
+static PHLWINDOWREF g_rightClickWindow;
+
+static void onMouseButtonForMenuFocus(const IPointer::SButtonEvent& e) {
+    if (e.state != WL_POINTER_BUTTON_STATE_PRESSED)
+        return;
+
+    const auto W = Desktop::focusState()->window();
+    if (e.button == BTN_RIGHT) {
+        g_rightClickWindow = W;
+        return;
+    }
+
+    const bool DISMISSES = W && e.button == BTN_LEFT && g_rightClickWindow.lock() == W;
+    g_rightClickWindow.reset();
+    if (!DISMISSES)
+        return;
+
+    // After Hyprland has handled this click.
