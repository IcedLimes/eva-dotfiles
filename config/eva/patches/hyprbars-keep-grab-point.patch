+// EVA: an app started a move by itself -- dragging its own title bar, like
+// Firefox's tab strip. If the Lua config has the window Plasma-style maximized,
+// let it restore the window under the cursor first, keeping the grabbed spot
+// (same relative x, same distance from the top), like a hyprbars drag.
+// Hooked at beginDragTarget: CWindow::onXDGMoveRequest is inlined into its
+// caller. App-initiated moves are the ones that grab the device exclusively.
+inline CFunctionHook* g_pBeginDragHook = nullptr;
+typedef void (*origBeginDrag)(Layout::CLayoutManager*, SP<Layout::ITarget>, eMouseBindMode, std::optional<Layout::eRectCorner>, bool);
+
+static void hkBeginDragTarget(Layout::CLayoutManager* thisptr, SP<Layout::ITarget> target, eMouseBindMode mode, std::optional<Layout::eRectCorner> forcedEdge,
+                              bool exclusiveDeviceGrab) {
+    const auto PWINDOW = target ? target->window() : nullptr;
+    if (PWINDOW && mode == MBIND_MOVE && exclusiveDeviceGrab && !Fullscreen::controller()->isFullscreen(PWINDOW)) {
+        const auto BOX = target->position();
+        if (BOX.w > 0 && BOX.h > 0) {
+            const auto   MOUSE = g_pInputManager->getMouseCoordsInternal();
+            const double FRACX = std::clamp((MOUSE.x - BOX.x) / BOX.w, 0.0, 1.0);
+            const double OFFY  = std::clamp(MOUSE.y - BOX.y, 0.0, BOX.h);
+            HyprlandAPI::invokeHyprctlCommand("eval",
+                                              std::format("if eva and eva.restore_for_move then eva.restore_for_move('0x{:x}', {}, {}, {}, {}) end", (uintptr_t)PWINDOW.get(),
+                                                          MOUSE.x, MOUSE.y, FRACX, OFFY));
+        }
+    }
+
+    (*(origBeginDrag)g_pBeginDragHook->m_original)(thisptr, target, mode, forcedEdge, exclusiveDeviceGrab);
+}
+
+// EVA: an app's own minimize button (Firefox's, in its tab bar). Hyprland
+// records the request and ignores it; hand it to the Lua config, which
+// minimizes the way the taskbar and SUPER+Down do.
+inline CFunctionHook* g_pUpdateStateHook = nullptr;
+typedef void (*origUpdateState)(Desktop::View::CWindow*);
+
+static void hkUpdateState(Desktop::View::CWindow* thisptr) {
+    bool minimize = false;
+    if (thisptr && thisptr->m_isMapped) {
+        if (const auto XDG = thisptr->m_xdgSurface.lock(); XDG) {
+            if (const auto TOPLEVEL = XDG->m_toplevel.lock(); TOPLEVEL)
+                minimize = TOPLEVEL->m_state.requestsMinimize.value_or(false);
+        } else if (const auto XWL = thisptr->m_xwaylandSurface.lock(); XWL)
+            minimize = XWL->m_state.requestsMinimize.value_or(false);
+    }
+
+    (*(origUpdateState)g_pUpdateStateHook->m_original)(thisptr);
+
+    if (minimize)
+        HyprlandAPI::invokeHyprctlCommand("eval", std::format("if eva and eva.minimize then eva.minimize('0x{:x}') end", (uintptr_t)thisptr));
+}
