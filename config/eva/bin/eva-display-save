#!/usr/bin/env python3
"""Save the current monitor layout so Hyprland applies it at every login.

Run after changing displays (eva-display runs it when wdisplays closes).
Writes ~/.config/eva/monitors.lua, which hyprland.lua loads.
"""
import json
import os
import re
import subprocess

HOME = os.path.expanduser("~")
OUT = os.path.join(HOME, ".config/eva/monitors.lua")
LOW_POWER = os.path.exists(os.path.join(HOME, ".config/eva/current/battery-mode"))


def best_rate(m):
    """Highest refresh rate available at the current resolution."""
    rates = [float(r) for w, h, r in (re.match(r"(\d+)x(\d+)@([\d.]+)", a).groups()
                                      for a in m.get("availableModes", []) if re.match(r"(\d+)x(\d+)@([\d.]+)", a))
             if int(w) == m["width"] and int(h) == m["height"]]
    return max(rates) if rates else m["refreshRate"]


mons = json.loads(subprocess.run(["hyprctl", "monitors", "all", "-j"],
                                 capture_output=True, text=True, check=True).stdout)
lines = ["-- generated by eva-display-save; loaded by hyprland.lua", "return {"]
for m in mons:
    name = m["name"]
    if name.startswith(("HEADLESS", "WAYLAND")):
        continue  # virtual outputs
    if m.get("disabled"):
        lines.append(f'    {{ output = "{name}", disabled = true }},')
        continue
    # Low-power mode drops the panel to 60 Hz; save its normal rate instead.
    rate = best_rate(m) if (LOW_POWER and name == "eDP-1") else m["refreshRate"]
    lines.append(f'    {{ output = "{name}", mode = "{m["width"]}x{m["height"]}@{round(rate, 3):g}", '
                 f'position = "{m["x"]}x{m["y"]}", scale = {m["scale"]:g}, transform = {m["transform"]} }},')
lines.append("}")

tmp = OUT + ".tmp"
with open(tmp, "w") as f:
    f.write("\n".join(lines) + "\n")
os.replace(tmp, OUT)
print(open(OUT).read(), end="")
