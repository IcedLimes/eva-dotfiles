--- a/StarryNight/theme.js
+++ b/StarryNight/theme.js
@@ -125,3 +125,34 @@
     });
   }
 });
+
+// eva: the stars and the spinning cover only move while Spotify has focus.
+// Chromium repaints every frame for them, which kept ~50% of the iGPU busy
+// even with Spotify paused and minimized; unfocused they hold still.
+// (The cover is paused by the eva-still class in user.css, so its own
+// play/pause styling keeps working; the stars' inline animations can only be
+// paused from script.)
+(function () {
+  const held = new Set();
+  const sync = () => {
+    const still = !document.hasFocus();
+    document.documentElement.classList.toggle('eva-still', still);
+    if (still) {
+      for (const a of document.getAnimations()) {
+        const el = a.effect && a.effect.target;
+        if (a.playState === 'running' && el && el.closest && el.closest('.starrynight-bg-container')) {
+          a.pause();
+          held.add(a);
+        }
+      }
+    } else {
+      for (const a of held) if (a.playState === 'paused') a.play();
+      held.clear();
+    }
+  };
+  window.addEventListener('blur', sync);
+  window.addEventListener('focus', sync);
+  // a shooting star starts a fresh animation each time one lands
+  document.addEventListener('animationstart', () => { if (!document.hasFocus()) sync(); }, true);
+  setTimeout(sync, 3000);
+})();
